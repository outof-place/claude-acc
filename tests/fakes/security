#!/usr/bin/python3
import os, shlex, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _store

os.makedirs(_store.ROOT, exist_ok=True)
# pełne argumenty każdego wywołania: testy sprawdzają, że sekret nie szedł w argumentach procesu
with open(os.path.join(_store.ROOT, "security-argv.log"), "a") as log:
    log.write(" ".join(sys.argv[1:]) + "\n")


def run(args):
    cmd = args[0]
    opt = lambda flag: args[args.index(flag) + 1] if flag in args else None
    key = f"{opt('-s')}|{opt('-a')}"
    # każde wywołanie w kolejności: testy liczą odczyty Pęku kluczy na przebieg
    with open(os.path.join(_store.ROOT, "security.log"), "a") as log:
        log.write(f"{cmd} {key}\n")
    kc = _store.load("keychain.json", {})
    if cmd == "find-generic-password":
        if key in kc:
            # bez -w prawdziwe `security` wypisuje tylko atrybuty wpisu, nie sekret
            print(kc[key] if "-w" in args else f'keychain: "fake"\n    "svce"<blob>="{opt("-s")}"')
            return 0
        return 44
    if cmd == "add-generic-password":
        if os.environ.get("FAKE_FAIL_WRITE_SERVICE") == opt("-s"):
            print("security: SecKeychainItemModifyContent: fake failure", file=sys.stderr)
            return 1
        if os.environ.get("FAKE_SLOW_WRITE_SERVICE") == opt("-s"):
            open(os.path.join(_store.ROOT, "slow-write-started"), "w").close()
            time.sleep(3)
        kc = _store.load("keychain.json", {})
        kc[key] = opt("-w")
        _store.save("keychain.json", kc)
        return 0
    if cmd == "delete-generic-password":
        existed = kc.pop(key, None) is not None
        _store.save("keychain.json", kc)
        return 0 if existed else 44
    if cmd == "dump-keychain":
        for k in kc:
            print(f'    "svce"<blob>="{k.split("|")[0]}"')
        return 0
    return 1


if sys.argv[1] == "-i":
    # tryb interaktywny: polecenia z stdin, linia po linii, jak `security -i`
    code = 0
    for line in sys.stdin.read().splitlines():
        if line.strip():
            code = run(shlex.split(line)) or code
    sys.exit(code)
sys.exit(run(sys.argv[1:]))

#!/usr/bin/python3
import os, shlex, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _store

os.makedirs(_store.ROOT, exist_ok=True)
# pełne argumenty każdego wywołania: testy sprawdzają, że sekret nie szedł w argumentach procesu
with open(os.path.join(_store.ROOT, "security-argv.log"), "a") as log:
    log.write(" ".join(sys.argv[1:]) + "\n")


def run(args):
    cmd = args[0]
    opt = lambda flag: args[args.index(flag) + 1] if flag in args else None
    key = f"{opt('-s')}|{opt('-a')}"
    # każde wywołanie w kolejności: testy liczą odczyty Pęku kluczy na przebieg
    with open(os.path.join(_store.ROOT, "security.log"), "a") as log:
        log.write(f"{cmd} {key}\n")
    kc = _store.load("keychain.json", {})
    if os.environ.get("FAKE_LOCKED_SERVICE") == opt("-s") and cmd in ("find-generic-password", "delete-generic-password"):
        # zablokowany Pęk kluczy (np. przez SSH): -25308 errSecInteractionNotAllowed, kod wyjścia 36
        print("security: SecKeychainSearchCopyNext: User interaction is not allowed.", file=sys.stderr)
        return 36
    if cmd == "find-generic-password":
        if key in kc:
            # bez -w prawdziwe `security` wypisuje tylko atrybuty wpisu, nie sekret
            print(kc[key] if "-w" in args else f'keychain: "fake"\n    "svce"<blob>="{opt("-s")}"')
            return 0
        return 44
    if cmd == "add-generic-password":
        if os.environ.get("FAKE_FAIL_WRITE_SERVICE") == opt("-s"):
            print("security: SecKeychainItemModifyContent: fake failure", file=sys.stderr)
            return 1
        if os.environ.get("FAKE_SLOW_WRITE_SERVICE") == opt("-s"):
            open(os.path.join(_store.ROOT, "slow-write-started"), "w").close()
            time.sleep(3)
        kc = _store.load("keychain.json", {})
        # -X: dane szesnastkowo, jak w `security -i` z claude-acc (sekret nie idzie w argumentach)
        kc[key] = bytes.fromhex(opt("-X")).decode() if "-X" in args else opt("-w")
        _store.save("keychain.json", kc)
        return 0
    if cmd == "delete-generic-password":
        if os.environ.get("FAKE_FAIL_DELETE_SERVICE") == opt("-s"):
            print("security: SecKeychainItemDelete: fake failure", file=sys.stderr)
            return 1
        existed = kc.pop(key, None) is not None
        _store.save("keychain.json", kc)
        return 0 if existed else 44
    if cmd == "dump-keychain":
        for k in kc:
            print(f'    "svce"<blob>="{k.split("|")[0]}"')
        return 0
    print(f'security: unknown command "{cmd}"', file=sys.stderr)  # jak prawdziwe, z nazwą polecenia
    return 1




def lines(data):
    """Jak fgets do bufora 4096 bajtów w `security -i`: z dłuższej linii pierwsze 4095 bajtów to jedno
    polecenie, a reszta następne (zmierzone na /usr/bin/security, macOS 27, nieznanym poleceniem)."""
    while data:
        cut = data.find(b"\n") + 1 or len(data)
        cut = min(cut, 4095)
        yield data[:cut].rstrip(b"\n").decode()
        data = data[cut:]


if sys.argv[1] == "-i":
    # tryb interaktywny: polecenia z stdin, linia po linii, jak `security -i`. Jak prawdziwe: kod wyjścia
    # to kod OSTATNIEGO polecenia (pusta linia to polecenie z kodem 0), a nieudane pisze na stderr
    # "<polecenie>: returned <kod>"
    code = 0
    for line in lines(sys.stdin.buffer.read()):
        args = shlex.split(line) if line.strip() else []
        code = run(args) if args else 0
        if code:
            print(f"{args[0]}: returned {code}", file=sys.stderr)
    sys.exit(code)
sys.exit(run(sys.argv[1:]))

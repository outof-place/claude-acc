#!/usr/bin/python3
"""Atrapa osascript: okno z ukrytym polem zwraca FAKE_DIALOG_ANSWER (albo anulowanie przy
FAKE_DIALOG_CANCEL), powiadomienia lądują w notify.log jak w atrapie z tests/fakes."""
import os, sys

root = os.path.join(os.environ["HOME"], "fake")
os.makedirs(root, exist_ok=True)
text = " ".join(sys.argv[1:])
if "display dialog" in text:
    with open(os.path.join(root, "dialog.log"), "a") as log:
        log.write(text + "\n")
    if os.environ.get("FAKE_DIALOG_CANCEL"):
        print("execution error: User canceled. (-128)", file=sys.stderr)
        sys.exit(1)
    print(os.environ.get("FAKE_DIALOG_ANSWER", ""))
    sys.exit(0)
with open(os.path.join(root, "notify.log"), "a") as log:
    log.write(text + "\n")

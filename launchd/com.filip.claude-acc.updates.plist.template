<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.filip.claude-acc.updates</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/claude-acc/python</string>
    <string>__HOME__/.local/share/claude-acc/acc.py</string>
    <string>updates</string>
    <string>run</string>
  </array>
  <!-- codziennie o 4:30 (uśpiony Mac nadrabia po obudzeniu); updates.py sam pilnuje 3 dni,
       a jego RUN_AT musi wskazywać tę samą godzinę -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/share/claude-acc/updates-launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/claude-acc/updates-launchd.log</string>
</dict>
</plist>

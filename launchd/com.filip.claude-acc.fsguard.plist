<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.filip.claude-acc.fsguard</string>
  <!-- __PYTHON__ wstawia install-fsguard.sh: interpreter należący do roota (rootpy.py), nigdy
       /usr/bin/python3, bo to zaślepka idąca do Xcode'a użytkownika -->
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-I</string>
    <string>/usr/local/libexec/claude-acc-fsguard</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardErrorPath</key><string>/Library/Logs/claude-acc-fsguard.log</string>
</dict>
</plist>

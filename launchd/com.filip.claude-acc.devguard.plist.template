<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.filip.claude-acc.devguard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/claude-acc/python</string>
    <string>__HOME__/.local/share/claude-acc/acc.py</string>
    <string>devguard</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <!-- Interactive: strażnik musi dostać CPU właśnie wtedy, gdy Mac się dusi, a Standard (jak brak
       ProcessType) to według man launchd.plist lekkie dławienie CPU i I/O -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/.local/share/claude-acc/devguard-launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/claude-acc/devguard-launchd.log</string>
</dict>
</plist>
